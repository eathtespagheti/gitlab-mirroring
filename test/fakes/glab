#!/bin/sh
# Fake `glab` for the test suite. Honors FAKE_* env vars and logs every call to
# ${FAKE_CALLS_LOG:-/dev/null}. Never used outside test/.
: "${FAKE_CALLS_LOG:=/dev/null}"
printf 'glab %s\n' "$*" >> "$FAKE_CALLS_LOG"
case "$1 $2" in
  "api user")
    if [ -n "${FAKE_GLAB_USER_JSON:-}" ]; then
      printf '%s\n' "$FAKE_GLAB_USER_JSON"
    else
      printf '%s\n' '{"username":"tester"}'
    fi ;;
  "repo list") cat "${FAKE_GLAB_PROJECTS:-/dev/null}" ;;
  "repo create") printf 'https://gitlab.com/%s\n' "$3" ;;
  "api "*)
    # Generic API call (endpoint in $2, flags in $3+). GETs dump
    # ${FAKE_GLAB_API_OUT}, the Task 4 remote_mirrors fixture. Mutations
    # (--input / -X|--method PUT|POST|DELETE) return ${FAKE_GLAB_API_RESPONSE}
    # when set; Task 6 extends the mutation handling.
    case " $* " in
      *" --input "* | *" -X PUT "* | *" -X POST "* | *" -X DELETE "* | \
      *" --method PUT "* | *" --method POST "* | *" --method DELETE "*)
        if [ -n "${FAKE_GLAB_API_RESPONSE:-}" ]; then
          cat "$FAKE_GLAB_API_RESPONSE"
        fi ;;
      *) if [ "${FAKE_GLAB_API_FAIL:-0}" = "1" ]; then
           printf 'fake-glab: api failure\n' >&2
           exit 1
         fi
         cat "${FAKE_GLAB_API_OUT:-/dev/null}" ;;
    esac ;;
  *) printf 'fake-glab: unhandled: %s\n' "$*" >&2; exit 1 ;;
esac
