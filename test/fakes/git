#!/bin/sh
# Fake `git` for the test suite: record every invocation's arguments in
# ${FAKE_GIT_LOG:-/dev/null} and succeed. Tests point GIT at this file so
# seeding clones/pushes are observed without touching a network. When
# ${FAKE_GIT_LSREMOTE} is set, `ls-remote` prints it, so the "already has refs"
# guard can be exercised. Never used outside test/.
: "${FAKE_GIT_LOG:=/dev/null}"
printf 'git %s\n' "$*" >> "$FAKE_GIT_LOG"
if [ "${1:-}" = "ls-remote" ] && [ -n "${FAKE_GIT_LSREMOTE:-}" ]; then
  printf '%s\n' "$FAKE_GIT_LSREMOTE"
fi
exit 0
